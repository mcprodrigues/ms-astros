WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_INDEX_NAME=AstrosMovies
WEAVIATE_CONNECT_ATTEMPTS=10
WEAVIATE_CONNECT_BACKOFF_SECONDS=1.0
CSV_FILE_PATH=data/movies.csv
EMBEDDINGS_PATH=data/embeddings/embeddings.parquet
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DEFAULT_TOP_K=5
MIN_SCORE_THRESHOLD=0.42
WEAVIATE_QUERY_TIMEOUT_SECONDS=10
WEAVIATE_INSERT_TIMEOUT_SECONDS=60
# Required for write/destructive routes (send as X-API-Key). Unset = writes disabled.
API_KEY=change-me
# JSON list of allowed browser origins, e.g. ["http://localhost:5173"]. Empty = no CORS.
CORS_ALLOW_ORIGINS=[]
MAX_UPLOAD_BYTES=10485760
